<?xml version="1.0" encoding="UTF-8"?>
<!-- AICP dropped the o8.1 branch of its system/core: take the LineageOS one it was based on -->
<manifest>
  <remove-project name="AICP/system_core" />
  <project path="system/core" name="LineageOS/android_system_core" remote="github" revision="refs/heads/lineage-15.1" groups="pdk" />
  <!-- Gone from omnirom; Oreo leaves out the missing product package -->
  <remove-project name="omnirom/android_packages_apps_OmniSwitch" />
  <!-- The newer Wi-Fi service calls framework APIs that this ROM does not
       have yet: take it from before them -->
  <remove-project name="LineageOS/android_frameworks_opt_net_wifi" />
  <project path="frameworks/opt/net/wifi" name="LineageOS/android_frameworks_opt_net_wifi" remote="github" revision="8d04d5cba4de843a70a251391a113e0d91193273" groups="pdk" />
</manifest>
