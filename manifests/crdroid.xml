<?xml version="1.0" encoding="UTF-8"?>
<!-- hwbinder comes from AOSP here, where the patches of this tree do not
     apply: take the LineageOS one, as the other ROMs do -->
<manifest>
  <remove-project name="platform/system/libhwbinder" />
  <project path="system/libhwbinder" name="LineageOS/android_system_libhwbinder" remote="github" revision="refs/heads/lineage-15.1" groups="pdk" />
  <remove-project name="platform/system/hwservicemanager" />
  <project path="system/hwservicemanager" name="LineageOS/android_system_hwservicemanager" remote="github" revision="refs/heads/lineage-15.1" groups="pdk" />
  <!-- The lineage-15.1 branch of the WebView is gone: take master, as AICP does -->
  <remove-project name="LineageOS/android_external_chromium-webview" />
  <project path="external/chromium-webview" name="LineageOS/android_external_chromium-webview" remote="github" revision="master" clone-depth="1" groups="pdk" />
  <!-- Gone; Oreo leaves out the missing product package -->
  <remove-project name="crdroidandroid/android_packages_apps_crDroidFileManager" />
  <!-- The frameworks/base of this ROM stops before SQLiteQueryBuilder learned
       setStrictGrammar(): take the providers from before they use it -->
  <remove-project name="LineageOS/android_packages_providers_ContactsProvider" />
  <project path="packages/providers/ContactsProvider" name="LineageOS/android_packages_providers_ContactsProvider" remote="github" revision="4dabe5308c84907c09cdba59bca482748aa6170c" groups="pdk-cw-fs,pdk-fs" />
  <!-- The newer Wi-Fi service calls framework APIs that this ROM does not
       have yet: take it from before them -->
  <remove-project name="LineageOS/android_frameworks_opt_net_wifi" />
  <project path="frameworks/opt/net/wifi" name="LineageOS/android_frameworks_opt_net_wifi" remote="github" revision="8d04d5cba4de843a70a251391a113e0d91193273" groups="pdk" />
  <!-- The 2026 MMS service passes the calling user to an IMms that this ROM
       does not have yet: take it from before -->
  <remove-project name="LineageOS/android_packages_services_Mms" />
  <project path="packages/services/Mms" name="LineageOS/android_packages_services_Mms" remote="github" revision="3abc1b0a40acd30e72ddca74d4f16ec54da1af0b" />
</manifest>
