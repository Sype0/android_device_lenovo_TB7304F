 ANDROID_SINGLETON_STATIC_INSTANCE( GraphicBufferMapper )
 
+// The gralloc of this device keeps a kernel side record of every buffer that
+// goes away when the allocating handle is freed, so the allocation cannot be
+// handed over to an imported copy the way the mapper HAL wants it. Buffers
+// allocated in this process keep their original handle instead, as they did
+// before Android 8.0, and are locked through the gralloc module directly.
+static std::mutex gLocalLock;
+static std::unordered_set<buffer_handle_t> gLocalBuffers;
+
+static const gralloc_module_t* localModule() {
+    static const gralloc_module_t* module = [] {
+        const hw_module_t* m = nullptr;
+        if (hw_get_module(GRALLOC_HARDWARE_MODULE_ID, &m) != 0) m = nullptr;
+        return reinterpret_cast<const gralloc_module_t*>(m);
+    }();
+    return module;
+}
+
+static bool isLocalBuffer(buffer_handle_t handle) {
+    std::lock_guard<std::mutex> lock(gLocalLock);
+    return gLocalBuffers.count(handle) != 0;
+}
+
+void GraphicBufferMapper::adoptLocalBuffer(buffer_handle_t handle) {
+    std::lock_guard<std::mutex> lock(gLocalLock);
+    gLocalBuffers.insert(handle);
+}
+
+bool GraphicBufferMapper::releaseLocalBuffer(buffer_handle_t handle) {
+    std::lock_guard<std::mutex> lock(gLocalLock);
+    return gLocalBuffers.erase(handle) != 0;
+}
+
 void GraphicBufferMapper::preloadHal() {
     Gralloc2::Mapper::preload();
 }
