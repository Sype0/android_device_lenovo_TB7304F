+bool ProcessState::isKernelBuffer(const void* ptr) const
+{
+    if (mVMStart == MAP_FAILED) return false;
+    const uint8_t* start = static_cast<const uint8_t*>(mVMStart);
+    const uint8_t* p = static_cast<const uint8_t*>(ptr);
+    return p >= start && p < start + BINDER_VM_SIZE;
+}
